{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@acme/ui/*": ["../ui/src/*"],
      "@acme/config/*": ["../config/*"],
      "@acme/prisma": ["../../prisma/client"],
      "@acme/lib/*": ["../ui/src/lib/*"]
    }
  }
}
