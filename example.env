# Server
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CDN_URL=https://cdn.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
ENABLE_FIREWALL=true
MAINTENANCE_MODE=false

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=marketplace
DB_TIMEZONE=Z
DB_CONNECTION_LIMIT=10

# JWT & Security
JWT_SECRET=please_change_me
JWT_EXPIRATION=2h
REFRESH_TOKEN_SECRET=please_change_me_refresh
REFRESH_TOKEN_EXPIRATION=7d
PASSWORD_SALT_ROUNDS=10
RECAPTCHA_SITE_KEY=recaptcha_site_key_here
RECAPTCHA_SECRET_KEY=recaptcha_secret_here
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# SMTP / Emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD=super_secret_password
SMTP_SECURE=false
SMTP_FROM=no-reply@example.com
SMTP_FROM_NAME=Marketplace Robot
SUPPORT_EMAIL=support@example.com

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_SUCCESS_URL=https://app.example.com/payments/success
STRIPE_CANCEL_URL=https://app.example.com/payments/cancel

# PayPal
PAYPAL_CLIENT_ID=paypal_client_id_here
PAYPAL_CLIENT_SECRET=paypal_client_secret_here
PAYPAL_MODE=sandbox
PAYPAL_WEBHOOK_ID=paypal_webhook_id_here
PAYPAL_MIN_WITHDRAW=10
PAYPAL_WITHDRAW_FEE_PERCENT=5

# Mercado Pago Perú
MERCADOPAGO_ACCESS_TOKEN=mp_access_token_here
MERCADOPAGO_PUBLIC_KEY=mp_public_key_here
MERCADOPAGO_INTEGRATOR_ID=mp_integrator_id_here
MERCADOPAGO_SUCCESS_URL=https://app.example.com/payments/success
MERCADOPAGO_FAILURE_URL=https://app.example.com/payments/failure
MERCADOPAGO_PENDING_URL=https://app.example.com/payments/pending

# Cryptomus
CRYPTOMUS_MERCHANT_ID=cryptomus_merchant_id_here
CRYPTOMUS_API_KEY=cryptomus_api_key_here
CRYPTOMUS_PAYMENT_URL=https://pay.cryptomus.com/pay
CRYPTOMUS_CALLBACK_URL=https://api.example.com/payments/cryptomus/callback

# Currency Conversion
CURRENCY_API_URL=https://open.er-api.com/v6/latest/USD
CURRENCY_API_KEY=external_rate_api_key_here
BASE_CURRENCY=USD
ENABLED_CURRENCIES=USD,EUR,GBP,PEN,BRL,MXN
CURRENCY_MARGIN_PERCENT=0

# Marketplace Branding & SEO
MARKETPLACE_NAME=NeoMarket
MARKETPLACE_BRAND_COLOR=#00ff88
MARKETPLACE_LOGO_URL=https://cdn.example.com/assets/logo.svg
MARKETPLACE_FAVICON_URL=https://cdn.example.com/assets/favicon.ico
SEO_META_TITLE=NeoMarket Digital Goods
SEO_META_DESCRIPTION=Marketplace profesional de productos digitales
SEO_KEYWORDS=marketplace,digital,saas
OG_IMAGE_URL=https://cdn.example.com/assets/og-image.png
JSON_LD_ENABLED=true
SITEMAP_URL=https://app.example.com/sitemap.xml
ROBOTS_DIRECTIVES=User-agent: *\nAllow: /
REDIRECTS_301=
REDIRECTS_302=
SCRIPT_INJECTOR_HEAD=
SCRIPT_INJECTOR_BODY=

# Seller Subscription & Wallet
SELLER_SUBSCRIPTION_PRICE=19.99
SELLER_SUBSCRIPTION_CURRENCY=USD
SELLER_SUBSCRIPTION_GRACE_DAYS=5
SELLER_AUTO_RENEW=true
SELLER_SUSPEND_IF_UNPAID=true
SELLER_REACTIVATE_ON_PAYMENT=true
SELLER_PRODUCT_SUSPEND_ON_HOLD=true
WALLET_MIN_TOPUP=1
WALLET_TOPUP_CURRENCIES=USD,EUR,PEN
WALLET_GENERAL_FEE_PERCENT=0

# Withdraw Methods
WITHDRAW_PAYPAL_MIN=10
WITHDRAW_PAYPAL_FEE_PERCENT=5
WITHDRAW_BINANCE_MIN=5
WITHDRAW_BINANCE_FEE_PERCENT=2
WITHDRAW_YAPE_MIN_USD=5
WITHDRAW_YAPE_FEE_PERCENT=0
WITHDRAW_CUSTOM_ALLOWED=true
WITHDRAW_PROCESSING_DAYS=3
WITHDRAW_ALERT_MESSAGE=Asegúrese que sus datos de retiro sean correctos. No habrá reembolsos por retiros enviados a datos incorrectos.

# Support & SLA
SUPPORT_SLA_HOURS=24
SUPPORT_TICKET_AUTO_CLOSE_DAYS=14
WARRANTY_DEFAULT_DAYS=30

# Affiliate & Coupons
AFFILIATE_DEFAULT_COMMISSION_PERCENT=5
COUPON_GLOBAL_MAX_DISCOUNT_PERCENT=50

# Integrations
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
GOOGLE_SEARCH_CONSOLE_VERIFICATION=verification_token_here
FACEBOOK_PIXEL_ID=000000000000000
TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXX

# Frontend (Vite) exposed vars
VITE_API_URL=${BACKEND_URL}${API_PREFIX}
VITE_FRONTEND_URL=${FRONTEND_URL}
VITE_DEFAULT_CURRENCY=${BASE_CURRENCY}
VITE_ENABLED_CURRENCIES=${ENABLED_CURRENCIES}
VITE_BRAND_COLOR=${MARKETPLACE_BRAND_COLOR}
VITE_STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}
VITE_PAYPAL_CLIENT_ID=${PAYPAL_CLIENT_ID}
VITE_MERCADOPAGO_PUBLIC_KEY=${MERCADOPAGO_PUBLIC_KEY}
VITE_RECAPTCHA_SITE_KEY=${RECAPTCHA_SITE_KEY}
VITE_GOOGLE_ANALYTICS_ID=${GOOGLE_ANALYTICS_ID}
VITE_GOOGLE_TAG_MANAGER_ID=${GOOGLE_TAG_MANAGER_ID}
VITE_FACEBOOK_PIXEL_ID=${FACEBOOK_PIXEL_ID}
VITE_TIKTOK_PIXEL_ID=${TIKTOK_PIXEL_ID}
