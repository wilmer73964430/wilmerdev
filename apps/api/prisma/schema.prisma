generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleType {
  ADMIN
  PROVEEDOR_STREAMING
  VENDEDOR
  AFILIADO
  USUARIO
  SOPORTE
}

enum PlanType {
  PRO
  SECONDARY
  SELLER
  AFFILIATE
}

enum ServiceType {
  SMM
  STREAMING
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELED
  PAST_DUE
  TRIALING
}

enum WalletOwnerType {
  USER
  SELLER
  AFFILIATE
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum WithdrawStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AffiliateModel {
  CPA
  REVSHARE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id          String     @id @default(cuid())
  email       String     @unique
  password    String
  role        RoleType
  profile     Profile?
  kycStatus   String?    @map("kyc_status")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  subscriptions Subscription[]
  orders      Order[]
  wallet      Wallet?
  affiliate   Affiliate?
  tickets     Ticket[]
  notifications Notification[]
  auditLogs   AuditLog[] @relation("AuditActor")
}

model Profile {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique @map("user_id")
  name      String?
  phone     String?
  locale    String?  @default("es")
  avatarUrl String?  @map("avatar_url")
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  permissions RolePermission[]
}

model Permission {
  id   String @id @default(cuid())
  key  String @unique
  rolePermissions RolePermission[]
}

model RolePermission {
  roleId       String  @map("role_id")
  permissionId String  @map("permission_id")
  role         Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Plan {
  id           String   @id @default(cuid())
  code         String   @unique
  type         PlanType
  price        Decimal  @db.Decimal(10, 2)
  currency     String   @default("USD")
  interval     String   @default("monthly")
  benefitsJson Json?    @map("benefits_json")
  limitsJson   Json?    @map("limits_json")
  active       Boolean  @default(true)
  subscriptions Subscription[]
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String             @map("user_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(ACTIVE)
  provider            String             @default("stripe")
  externalSubId       String?            @map("external_sub_id")
  currentPeriodStart  DateTime?          @map("current_period_start")
  currentPeriodEnd    DateTime?          @map("current_period_end")
  secondaryPanelKey   String?            @map("secondary_panel_key")
  secondaryDomain     String?            @map("secondary_domain")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")
  user                User               @relation(fields: [userId], references: [id])
  plan                Plan               @relation(fields: [planId], references: [id])
  domains             Domain[]
}

model Service {
  id            String      @id @default(cuid())
  type          ServiceType
  providerId    String?     @map("provider_id")
  name          String
  sku           String      @unique
  metadataJson  Json?       @map("metadata_json")
  basePrice     Decimal     @db.Decimal(10, 2) @map("base_price")
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  provider      Provider?   @relation(fields: [providerId], references: [id])
  orderItems    OrderItem[]
  inventories   ProviderInventory[]
}

model Provider {
  id               String    @id @default(cuid())
  name             String
  type             String
  apiBase          String?   @map("api_base")
  apiKeyEncrypted  String?   @map("api_key_encrypted")
  active           Boolean   @default(true)
  services         Service[]
  inventories      ProviderInventory[]
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
}

model ProviderInventory {
  id          String   @id @default(cuid())
  providerId  String   @map("provider_id")
  serviceId   String   @map("service_id")
  stock       Int      @default(0)
  reserved    Int      @default(0)
  metadataJson Json?   @map("metadata_json")
  provider    Provider @relation(fields: [providerId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([providerId, serviceId], name: "providerId_serviceId")
}

model Order {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  total            Decimal  @db.Decimal(10, 2)
  currency         String   @default("USD")
  status           String
  paymentProvider  String   @map("payment_provider")
  externalPaymentId String? @map("external_payment_id")
  affiliateId      String?  @map("affiliate_id")
  resellerId       String?  @map("reseller_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id])
  affiliate        Affiliate? @relation(fields: [affiliateId], references: [id])
  orderItems       OrderItem[]
  walletTransactions WalletTransaction[]
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String   @map("order_id")
  serviceId        String   @map("service_id")
  quantity         Int      @default(1)
  unitPrice        Decimal  @db.Decimal(10, 2) @map("unit_price")
  discountApplied  Decimal? @db.Decimal(10, 2) @map("discount_applied")
  metadataJson     Json?    @map("metadata_json")
  createdAt        DateTime @default(now()) @map("created_at")
  order            Order    @relation(fields: [orderId], references: [id])
  service          Service  @relation(fields: [serviceId], references: [id])
}

model DiscountRule {
  id          String   @id @default(cuid())
  appliesTo   String   @map("applies_to")
  percent     Int
  planRequired String? @map("plan_required")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
}

model Wallet {
  id         String          @id @default(cuid())
  ownerType  WalletOwnerType @map("owner_type")
  ownerId    String          @map("owner_id") @unique
  balance    Decimal         @db.Decimal(12, 2)
  currency   String          @default("USD")
  transactions WalletTransaction[]
  withdrawRequests WithdrawRequest[]
  user       User?            @relation(fields: [ownerId], references: [id])
}

model WalletTransaction {
  id         String          @id @default(cuid())
  walletId   String          @map("wallet_id")
  type       TransactionType
  amount     Decimal         @db.Decimal(12, 2)
  reason     String
  refType    String?         @map("ref_type")
  refId      String?         @map("ref_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  wallet     Wallet          @relation(fields: [walletId], references: [id])
  order      Order?          @relation(fields: [refId], references: [id])
}

model WithdrawRequest {
  id         String         @id @default(cuid())
  walletId   String         @map("wallet_id")
  amount     Decimal        @db.Decimal(12, 2)
  method     String
  accountRef String         @map("account_ref")
  status     WithdrawStatus @default(PENDING)
  reviewedBy String?        @map("reviewed_by")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")
  wallet     Wallet         @relation(fields: [walletId], references: [id])
}

model Affiliate {
  id              String         @id @default(cuid())
  userId          String         @map("user_id") @unique
  code            String         @unique
  model           AffiliateModel
  percent         Int            @default(10)
  cookieWindowDays Int          @map("cookie_window_days") @default(30)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  user            User           @relation(fields: [userId], references: [id])
  referrals       Referral[]
}

model Referral {
  id          String   @id @default(cuid())
  affiliateId String   @map("affiliate_id")
  userId      String   @map("user_id")
  orderId     String?  @map("order_id")
  commissionAmount Decimal? @db.Decimal(10, 2) @map("commission_amount")
  status      String
  createdAt   DateTime @default(now()) @map("created_at")
  affiliate   Affiliate @relation(fields: [affiliateId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  order       Order?    @relation(fields: [orderId], references: [id])
}

model CourseModule {
  id          String         @id @default(cuid())
  title       String
  description String?
  position    Int            @default(0)
  lessons     CourseLesson[]
  createdAt   DateTime       @default(now()) @map("created_at")
}

model CourseLesson {
  id          String        @id @default(cuid())
  moduleId    String        @map("module_id")
  title       String
  contentUrl  String?       @map("content_url")
  position    Int           @default(0)
  module      CourseModule  @relation(fields: [moduleId], references: [id])
  progresses  CourseProgress[]
  createdAt   DateTime      @default(now()) @map("created_at")
}

model CourseProgress {
  id         String       @id @default(cuid())
  lessonId   String       @map("lesson_id")
  userId     String       @map("user_id")
  completed  Boolean      @default(false)
  completedAt DateTime?   @map("completed_at")
  lesson     CourseLesson @relation(fields: [lessonId], references: [id])
  user       User         @relation(fields: [userId], references: [id])

  @@unique([lessonId, userId], name: "lessonId_userId")
}

model Ticket {
  id          String        @id @default(cuid())
  userId      String        @map("user_id")
  subject     String
  status      TicketStatus  @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?       @map("assigned_to")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id])
  messages    TicketMessage[]
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  body       String
  createdAt  DateTime @default(now()) @map("created_at")
  ticket     Ticket   @relation(fields: [ticketId], references: [id])
  author     User     @relation(fields: [authorId], references: [id])
}

model Domain {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id") @unique
  subdomain      String?
  apexDomain     String?       @map("apex_domain")
  status         String
  sslStatus      String?       @map("ssl_status")
  createdAt      DateTime      @default(now()) @map("created_at")
  subscription   Subscription  @relation(fields: [subscriptionId], references: [id])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   @map("actor_id")
  action     String
  entity     String
  entityId   String   @map("entity_id")
  diffJson   Json?    @map("diff_json")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  type        String
  payloadJson Json?    @map("payload_json")
  readAt      DateTime? @map("read_at")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])
}
